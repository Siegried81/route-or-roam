# Copy to .env and fill in. Never commit .env.
# Groq (default provider). Extra keys are used in turn when one is rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
RR_LLM_PROVIDER=groq            # groq | ollama
RR_GROQ_MODEL=openai/gpt-oss-20b
RR_OLLAMA_BASE_URL=http://localhost:11434/v1
RR_OLLAMA_MODEL=llama3.2:3b
# Where grounded-rag lives (its indexes and embedder settings are reused in place).
GROUNDED_RAG_PATH=../grounded-rag
# Per-run budget, identical for both systems.
RR_MAX_STEPS=8
RR_MAX_TOKENS=12000
