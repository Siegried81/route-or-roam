# Copy to .env and fill in. Never commit .env.
# Groq (default provider). Extra keys are used in turn when one is rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
RR_LLM_PROVIDER=groq            # groq | ollama
RR_GROQ_MODEL=openai/gpt-oss-20b
RR_OLLAMA_BASE_URL=http://localhost:11434/v1
RR_OLLAMA_MODEL=llama3.2:3b
# Where grounded-rag lives (its indexes and embedder settings are reused in place).
GROUNDED_RAG_PATH=../grounded-rag
# Per-run budget, identical for both systems.
RR_MAX_STEPS=8
RR_MAX_TOKENS=12000
# Who may approve a paused agent run through the API. Empty: only this machine
# can (the default for a local tool). Set it before exposing the API beyond
# localhost; the caller then sends it as the X-Approve-Token header.
RR_APPROVE_TOKEN=

# --- Tracing (LangSmith, optional) -----------------------------------------
# With both set, LangGraph traces every node of both systems - prompt, output,
# latency, tokens - tagged by system so the workflow's traces and the agent's can
# be filtered apart and compared question by question. That comparison is what
# the eval cannot show: the two score the same and fail differently, and a trace
# shows WHERE each one spent its calls.
#
# WHAT IT COSTS: traces go to LangChain's servers, so questions, retrieved
# passages and model outputs leave this machine. Both corpora here are public (an
# Apple 10-K and an EU AI Act primer), so that is acceptable - it would not be on
# a private corpus. Turn it on deliberately.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=route-or-roam
